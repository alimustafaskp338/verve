# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, email verification links, and API endpoints.
APP_URL="MY_APP_URL"

# Application Session & Cryptography Secret
# A high-entropy random secret used to secure session cookies and tokens.
# Required in production environments.
SESSION_SECRET="replace-with-a-secure-random-secret-key-32-chars-min"

# Database Connection URL
# Defaults to file:data/verve.db for zero-config durable local persistence.
# For distributed production deployments, provide a remote LibSQL / Turso connection URL (libsql://...).
DATABASE_URL="file:data/verve.db"

# Storage Configuration
# Driver options: 'local' (stores in UPLOAD_DIR with static HTTP serving).
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Transactional Email Configuration (SMTP)
# Configure these variables to deliver production emails via Gmail SMTP or standard SMTP.
# Supports Gmail with TLS/STARTTLS on port 587 (or SSL on port 465).
# If unconfigured, the application falls back to the in-app Dev Outbox for local testing.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM="Verve <no-reply@verve-social.app>"
